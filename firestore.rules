rules_version = '2';

// The database rules for Life Hub and the Mongolian app, which share this
// Firebase project and account. Paste all of this into the Firebase console
// (Firestore → Rules) and press Publish — see SETUP.md, and SYNC.md in the
// Mongolian app's folder.
//
// Each signed-in account can read and write only its own documents:
//   Life Hub     users/{its uid}/data/main and one document per year (2026, 2027, …)
//   Mongolian    users/{its uid}/mongolian/main, items-0, items-1, … and one per year
// Everything else, including anyone not signed in, is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/data/{doc} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && (doc == 'main' || doc.matches('[0-9]{4}'));
    }
    match /users/{uid}/mongolian/{doc} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && (doc == 'main' || doc.matches('items-[0-9]+') || doc.matches('[0-9]{4}'));
    }
  }
}
